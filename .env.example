# ============================================================
# PORTFOLIO — Variables de entorno requeridas
# Copia este archivo: cp .env.example .env
# NO subas .env al repositorio (está en .gitignore)
# ============================================================

# --- DJANGO CORE ---
DJANGO_ENV=development          # development | production | testing
DEBUG=True                      # False en producción (OBLIGATORIO)
# Genera con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# --- HOSTS ---
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com

# --- BASE DE DATOS ---
# Dejar vacío para SQLite local (desarrollo).
# En producción: URL completa de Supabase/Render/Fly.io
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- RECAPTCHA v3 ---
# Obtén las claves en: https://www.google.com/recaptcha/admin
RECAPTCHA_PUBLIC_KEY=your-recaptcha-public-key
RECAPTCHA_PRIVATE_KEY=your-recaptcha-private-key
