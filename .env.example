# ===============================================
# CONFIGURACIÓN PARA RENDER.COM
# ===============================================

# ⚠️  NO USES ESTE ARCHIVO EN PRODUCCIÓN
# Este archivo es solo un EJEMPLO de las variables necesarias

# Django
SECRET_KEY=tu_django_secret_key_muy_largo_y_seguro_aqui
DEBUG=false
DJANGO_SETTINGS_MODULE=app.app.settings

# Allowed Hosts (reemplaza con tu dominio en Render)
ALLOWED_HOSTS=portfolio.onrender.com,www.portfolio.onrender.com,localhost,127.0.0.1

# Base de Datos (Render la genera automáticamente)
# No necesitas configurarla manualmente, Render la crea
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email (opcional, para formularios de contacto)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=tu_email@gmail.com
EMAIL_HOST_PASSWORD=tu_app_password

# AWS S3 (opcional, para almacenar archivos estáticos/media)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Ruta de almacenamiento de datos
DATA_DIR=/data

# ===============================================
# CÓMO USAR ESTE ARCHIVO
# ===============================================

# 1. Copia este archivo a .env
#    cp .env.example .env

# 2. Relena los valores (lokalmente)
#    nano .env

# 3. En Render.com:
#    - NO subas .env al repositorio
#    - Configura las variables en Render Dashboard
#    - Environment → Add environment variables

# 4. Para desarrollo local:
#    - Instala python-dotenv
#    - pip install python-dotenv
#    - En manage.py o settings.py agrega:
#      from dotenv import load_dotenv
#      load_dotenv()
